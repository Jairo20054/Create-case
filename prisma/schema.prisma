generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER @map("customer")
  ADMIN    @map("admin")
  BRAND    @map("brand")

  @@map("user_role")
}

enum ProductType {
  CASE
  SCREEN_PROTECTOR
  CAMERA_PROTECTOR
  CHARGER
  POWER_BANK
  WALLET
  STAND
  STRAP
  CHARM
  OTHER

  @@map("product_type")
}

enum CompatibilityMode {
  UNIVERSAL
  BRAND_SPECIFIC
  DEVICE_SPECIFIC

  @@map("compatibility_mode")
}

model Profile {
  id            String         @id @db.Uuid
  fullName      String?        @map("full_name")
  email         String?
  phone         String?
  avatarUrl     String?        @map("avatar_url")
  role          UserRole       @default(CUSTOMER)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  cartItems     CartItem[]
  customDesigns CustomDesign[]
  favorites     Favorite[]
  orders        Order[]
  reviews       Review[]

  @@map("profiles")
}

model DeviceBrand {
  id             String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String                        @unique
  slug           String                        @unique
  logoUrl        String?                       @map("logo_url")
  isActive       Boolean                       @default(true) @map("is_active")
  createdAt      DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                      @updatedAt @map("updated_at") @db.Timestamptz(6)
  devices        Device[]
  compatibilities ProductVariantBrand[]

  @@map("brands")
}

model Device {
  id             String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  brandId        String                   @map("brand_id") @db.Uuid
  name           String
  slug           String
  releaseYear    Int?                     @map("release_year") @db.SmallInt
  screenSize     Decimal?                 @map("screen_size") @db.Decimal(4, 2)
  modelCode      String?                  @map("model_code")
  imageUrl       String?                  @map("image_url")
  isActive       Boolean                  @default(true) @map("is_active")
  createdAt      DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  brand          DeviceBrand              @relation(fields: [brandId], references: [id], onDelete: Restrict)
  capabilities   DeviceCapability[]
  cartItems      CartItem[]
  customDesigns  CustomDesign[]
  variantDevices ProductVariantDevice[]

  @@unique([brandId, slug])
  @@index([brandId, isActive])
  @@index([name])
  @@index([modelCode])
  @@map("phone_models")
}

model Collection {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  slug        String    @unique
  description String?
  imageUrl    String?   @map("image_url")
  launchDate  DateTime? @map("launch_date") @db.Timestamptz(6)
  active      Boolean   @default(true)
  products    Product[]

  @@map("collections")
}

model Product {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String
  slug              String             @unique
  description       String             @default("")
  productType       ProductType        @default(OTHER) @map("product_type")
  compatibilityMode CompatibilityMode  @default(DEVICE_SPECIFIC) @map("compatibility_mode")
  isDemo            Boolean            @default(false) @map("is_demo")
  isActive          Boolean            @default(true) @map("active")
  isFeatured        Boolean            @default(false) @map("featured")
  limited           Boolean            @default(false)
  technologyTags    String[]           @default([]) @map("technology_tags")
  collectionId      String?            @map("collection_id") @db.Uuid
  legacyBasePrice   Decimal?           @map("price") @db.Decimal(12, 2)
  legacyCategory    String?            @map("category")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  collection        Collection?        @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  favorites         Favorite[]
  images            ProductImage[]
  reviews           Review[]
  variants          ProductVariant[]

  @@index([isActive, isDemo])
  @@index([productType, isActive])
  @@map("products")
}

model ProductVariant {
  id              String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId       String                         @map("product_id") @db.Uuid
  sku             String                         @unique
  name            String?
  color           String
  design          String?
  material        String?
  price           Decimal                        @db.Decimal(12, 2)
  compareAtPrice  Decimal?                       @map("compare_at_price") @db.Decimal(12, 2)
  cost            Decimal?                       @db.Decimal(12, 2)
  imageUrl        String?                        @map("image_url")
  isActive        Boolean                        @default(true) @map("is_active")
  createdAt       DateTime                       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                       @updatedAt @map("updated_at") @db.Timestamptz(6)
  product         Product                        @relation(fields: [productId], references: [id], onDelete: Cascade)
  brandCompatibility ProductVariantBrand[]
  cartItems       CartItem[]
  deviceCompatibility ProductVariantDevice[]
  images          ProductImage[]
  inventory       Inventory?
  orderItems      OrderItem[]
  requirements    VariantCapabilityRequirement[]

  @@index([productId, isActive])
  @@map("product_variants")
}

model ProductVariantDevice {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productVariantId String         @map("product_variant_id") @db.Uuid
  deviceId         String         @map("device_id") @db.Uuid
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  device           Device         @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  @@unique([productVariantId, deviceId])
  @@index([deviceId, productVariantId])
  @@index([productVariantId])
  @@map("product_variant_devices")
}

model ProductVariantBrand {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productVariantId String         @map("product_variant_id") @db.Uuid
  brandId          String         @map("brand_id") @db.Uuid
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  brand            DeviceBrand    @relation(fields: [brandId], references: [id], onDelete: Restrict)
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  @@unique([productVariantId, brandId])
  @@index([brandId, productVariantId])
  @@map("product_variant_brands")
}

model Capability {
  id          String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String                         @unique
  name        String
  description String?
  createdAt   DateTime                       @default(now()) @map("created_at") @db.Timestamptz(6)
  devices     DeviceCapability[]
  requirements VariantCapabilityRequirement[]

  @@map("capabilities")
}

model DeviceCapability {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deviceId     String     @map("device_id") @db.Uuid
  capabilityId String     @map("capability_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  capability   Capability @relation(fields: [capabilityId], references: [id], onDelete: Cascade)
  device       Device     @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, capabilityId])
  @@index([capabilityId, deviceId])
  @@map("device_capabilities")
}

model VariantCapabilityRequirement {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productVariantId String         @map("product_variant_id") @db.Uuid
  capabilityId     String         @map("capability_id") @db.Uuid
  isRequired       Boolean        @default(true) @map("is_required")
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  capability       Capability     @relation(fields: [capabilityId], references: [id], onDelete: Restrict)
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  @@unique([productVariantId, capabilityId])
  @@index([capabilityId, productVariantId])
  @@map("variant_capability_requirements")
}

model Inventory {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productVariantId  String         @unique @map("product_variant_id") @db.Uuid
  quantity          Int            @default(0)
  reservedQuantity  Int            @default(0) @map("reserved_quantity")
  lowStockThreshold Int            @default(5) @map("low_stock_threshold")
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  productVariant    ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  @@index([quantity, reservedQuantity])
  @@map("inventory")
}

model ProductImage {
  id        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String          @map("product_id") @db.Uuid
  variantId String?         @map("variant_id") @db.Uuid
  imageUrl  String          @map("image_url")
  position  Int             @default(0) @db.SmallInt
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([productId, position])
  @@map("product_images")
}

model Favorite {
  userId    String   @map("user_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
  @@map("favorites")
}

model CustomDesign {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  phoneModelId String?  @map("phone_model_id") @db.Uuid
  imageUrl     String?  @map("image_url")
  textContent  String?  @map("text_content")
  font         String?
  color        String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  device       Device?  @relation(fields: [phoneModelId], references: [id], onDelete: SetNull)
  user         Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("custom_designs")
}

model CartItem {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  variantId String         @map("variant_id") @db.Uuid
  deviceId  String         @map("device_id") @db.Uuid
  quantity  Int
  unitPrice Decimal        @map("unit_price") @db.Decimal(12, 2)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  device    Device         @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  user      Profile        @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([userId, variantId, deviceId])
  @@index([userId, updatedAt])
  @@map("cart_items")
}

model Order {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String?     @map("user_id") @db.Uuid
  orderNumber     String      @unique @map("order_number")
  status          String      @default("pending")
  subtotal        Decimal     @db.Decimal(12, 2)
  shippingAddress Json        @default("{}") @map("shipping_address")
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  items           OrderItem[]
  user            Profile?    @relation(fields: [userId], references: [id])

  @@map("orders")
}

model OrderItem {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId     String          @map("order_id") @db.Uuid
  variantId   String?         @map("variant_id") @db.Uuid
  productName String          @map("product_name")
  quantity    Int
  unitPrice   Decimal         @map("unit_price") @db.Decimal(12, 2)
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant     ProductVariant? @relation(fields: [variantId], references: [id])

  @@map("order_items")
}

model Review {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  rating    Int
  body      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      Profile? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("reviews")
}
